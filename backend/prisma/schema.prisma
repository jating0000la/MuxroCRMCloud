generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  password      String
  name          String
  email         String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedLeads     Lead[]           @relation("Doer")
  managedCampaigns  Campaign[]       @relation("Manager")
  campaignUsers     CampaignUser[]
  followups         Followup[]
  notifications     Notification[]

  @@index([role])
  @@index([isActive])
}

model Campaign {
  id            String    @id @default(uuid())
  name          String
  description   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  managerId     String?
  manager       User?     @relation("Manager", fields: [managerId], references: [id])

  forms         Form[]
  leads         Lead[]
  assignedUsers CampaignUser[]
  statuses      CampaignStatus[]

  @@index([managerId])
  @@index([isActive])
}

model CampaignUser {
  id            String    @id @default(uuid())
  campaignId    String
  userId        String
  isActive      Boolean   @default(true)
  assignedAt    DateTime  @default(now())

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([isActive])
}

model CampaignStatus {
  id            String    @id @default(uuid())
  campaignId    String
  label         String
  color         String    @default("#3B82F6")
  order         Int       @default(0)

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads         Lead[]

  @@index([campaignId])
}

model Form {
  id            String    @id @default(uuid())
  campaignId    String
  title         String
  fields        Json      @default("[]")
  isPublished   Boolean   @default(false)
  publicSlug    String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submissions   Enquiry[]

  @@index([campaignId])
  @@index([isPublished])
}

model Enquiry {
  id            String    @id @default(uuid())
  formId        String
  data          Json
  submittedAt   DateTime  @default(now())
  ipAddress     String?

  form          Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  lead          Lead?

  @@index([formId, submittedAt])     // For form submission history
  @@index([submittedAt])
}

model Lead {
  id            String    @id @default(uuid())
  campaignId    String
  enquiryId     String?   @unique
  name          String
  email         String?
  phone         String?
  source        String    @default("manual")
  customData    Json?
  dnd           Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  campaign      Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  enquiry       Enquiry?      @relation(fields: [enquiryId], references: [id])
  doerId        String?
  doer          User?         @relation("Doer", fields: [doerId], references: [id])
  statusId      String?
  status        CampaignStatus? @relation(fields: [statusId], references: [id])
  followups     Followup[]

  @@index([campaignId])
  @@index([doerId])
  @@index([statusId])
  @@index([source])
  @@index([dnd])
  @@index([name])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([campaignId, doerId])
  @@index([campaignId, statusId])
  @@index([doerId, dnd])
}

model Followup {
  id            String    @id @default(uuid())
  leadId        String
  userId        String
  status        String
  remarks       String?
  nextCallDate  DateTime?
  createdAt     DateTime  @default(now())

  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([leadId])
  @@index([userId])
  @@index([nextCallDate])
  @@index([createdAt])
  @@index([userId, nextCallDate])
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  followupId    String
  type          String    // "overdue", "today", "tomorrow", "warning"
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  followup      Followup  @relation(fields: [followupId], references: [id], onDelete: Cascade)

  @@unique([userId, followupId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
}

model Setting {
  id            String    @id @default(uuid())
  key           String    @unique
  encryptedValue String
  isEncrypted   Boolean   @default(true)
  lastTestedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     SettingAuditLog[]

  @@index([key])
  @@index([updatedAt])
}

model SettingAuditLog {
  id            String    @id @default(uuid())
  settingId     String
  action        String    @default("update")
  changedBy     String?
  oldValue      String?
  newValue      String?
  reason        String?
  createdAt     DateTime  @default(now())

  setting       Setting   @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@index([settingId])
  @@index([createdAt])
}
