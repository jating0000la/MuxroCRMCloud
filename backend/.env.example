# ============================================
# Muxro CRM Cloud - Backend Production Config
# ============================================

# Database Configuration - Optimized for 2GB VPS
# Connection pooling: 3-5 concurrent connections max
# Use 127.0.0.1 for VPS deployments, postgres (container name) for Docker Compose
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB:-crm_db}?schema=public&connection_limit=5"

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT=30000
DATABASE_STATEMENT_TIMEOUT=30000

# Authentication
JWT_SECRET="${JWT_SECRET}"
JWT_EXPIRATION="${JWT_EXPIRATION:-7d}"

# Server
PORT=3000
NODE_ENV=production

# Networking
CORS_ORIGIN="${CORS_ORIGIN:-http://localhost}"

# Features
SWAGGER_ENABLED="${SWAGGER_ENABLED:-false}"
PUBLIC_FORMS_ENABLED="${PUBLIC_FORMS_ENABLED:-true}"

# Rate Limiting (optimized for 2GB VPS: 40-80 daily active users)
THROTTLE_LIMIT=80
THROTTLE_TTL=60000

# Optional: Redis Cache (improves dashboard response by 10x)
# Uncomment if using Redis for caching
# REDIS_URL=redis://redis:6379/0
# CACHE_TTL=3600

