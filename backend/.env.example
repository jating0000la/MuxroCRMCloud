# ============================================
# Muxro CRM Cloud - Backend Production Config
# ============================================

# Database Configuration - Optimized for 2GB VPS
# Connection pooling: 3-5 concurrent connections max
# Use 127.0.0.1 for VPS deployments, postgres (container name) for Docker Compose
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@127.0.0.1:5432/${POSTGRES_DB:-crm_db}?schema=public&connection_limit=5"

# Database connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT=30000
DATABASE_STATEMENT_TIMEOUT=30000

# Authentication
JWT_SECRET="${JWT_SECRET}"
# Access token: short-lived (15-30 min), sent in response body
ACCESS_TOKEN_EXPIRATION="${ACCESS_TOKEN_EXPIRATION:-15m}"
# Refresh token: long-lived (7-30 days), stored in HttpOnly cookie
REFRESH_TOKEN_EXPIRATION="${REFRESH_TOKEN_EXPIRATION:-7d}"

# Server
PORT=3000
NODE_ENV=production

# Networking
CORS_ORIGIN="${CORS_ORIGIN:-http://localhost}"

# Features
SWAGGER_ENABLED="${SWAGGER_ENABLED:-false}"
PUBLIC_FORMS_ENABLED="${PUBLIC_FORMS_ENABLED:-true}"

# Database backups: directory owned by the backend/CLI OS user.
# Install pg_dump, pg_restore and psql matching the server's major version.
# Automatic execution requires an external schedule; see BACKUP_AUDIT.md.
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7

# Rate Limiting (optimized for 2GB VPS: 40-80 daily active users)
THROTTLE_LIMIT=80
THROTTLE_TTL=60000

# Optional: Redis Cache (improves dashboard response by 10x)
# Uncomment if using Redis for caching
# REDIS_URL=redis://redis:6379/0
# CACHE_TTL=3600


# WhatsApp webhooks are disabled until this local application secret is configured.
# Generate with: openssl rand -hex 32
# Configure X-Webhook-Token on message/delivery callbacks. If custom headers are
# unavailable, append ?token=<secret> to the callback URL and omit query strings
# from reverse-proxy access logs. Settings > Communication can generate a stored
# callback token; that token takes precedence over this environment fallback.
GUPSHUP_WEBHOOK_TOKEN=

# Public CRM address used for temporary WhatsApp attachment links.
PUBLIC_BASE_URL=https://muxrocrm.cloud
# Files are served for 24 hours and removed by the running API's cleanup task.
WHATSAPP_UPLOAD_DIR=uploads/whatsapp
