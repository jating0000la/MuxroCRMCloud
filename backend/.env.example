# ============================================
# Muxro CRM Cloud - Backend Production Config
# ============================================

DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-crm_db}?schema=public"
JWT_SECRET="${JWT_SECRET}"
JWT_EXPIRATION="${JWT_EXPIRATION:-7d}"
PORT=3000
NODE_ENV=production
CORS_ORIGIN="${CORS_ORIGIN:-http://localhost}"
SWAGGER_ENABLED="${SWAGGER_ENABLED:-false}"
